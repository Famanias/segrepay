# SegrePay Frontend Environment Variables
# Copy this file to .env and fill in your credentials

# ============================================
# BLOCKCHAIN CONFIGURATION
# ============================================

# Avalanche Fuji Testnet Contract Addresses
# Update these after deploying contracts
VITE_SEGRE_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
VITE_SEG_REWARDS_ADDRESS=0x0000000000000000000000000000000000000000

# Use mock data for development (set to 'true' for demo without contracts)
# Set to 'false' when using real contracts + Supabase
VITE_USE_MOCK_DATA=true

# Optional: Custom RPC endpoint (defaults to public Fuji RPC)
# VITE_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc

# ============================================
# SUPABASE CONFIGURATION
# ============================================

# Get these from your Supabase project: Project Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Note: For hackathon demo, you can use:
# 1. Mock mode: No Supabase needed
# 2. Partial real: Supabase + real contracts (AI still simulated)
# 3. Full real: Would require actual AI service integration
